datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum ServiceCenter {
  EWETA
  ILA
  INISA
  IRAGBIJI
  IREE
  ODOFUN
  STATION_ROAD
}

enum CustomerType {
  PREPAID
  POSTPAID
}

enum MeterType {
  LONGI
  MOJEC
  MOMAS
  PROTOGY
  HEXIN
  IRL
  NSTS
  PREPAID
  POSTPAID
  TC_AND_P
  HOLLEY
  NEW_HAMPSHIRE
  PAKTIM
}

enum PremiseType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  GOVERNMENT
}

enum MeterPhase {
  Q1
  Q3
  WHOLE_CURRENT
  LVMD
  HVMD
}

enum CustomerCategory {
  MD1
  MD2
  NMD
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  DISCONNECTED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMINISTRATOR
  DATA_MANAGER
  SUPERVISOR
  ENUMERATOR
  VIEWER
}

enum Hub {
  ALL
  OSOGBO
  EDE
  ILE_IFE
  ILESA
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ImportJobStatus {
  VALIDATED
  COMMITTED
  FAILED
}

model Customer {
  id Int @id @default(autoincrement())

  // Account and meter
  account_number String  @unique
  meter_number   String? @unique

  // Personal information
  surname    String
  first_name String
  other_name String?
  nin        String? 

  // Customer classification
  customer_type     CustomerType?
  customer_category CustomerCategory?
  premise_type      PremiseType?
  meter_type        MeterType?
  meter_phase       MeterPhase?

  // Location / service
  address        String?
  city           String?
  state          String?
  lga            String?
  service_center ServiceCenter?
  service_code   String?
  tariff         String?
  longitude      Float?
  latitude       Float?

  // Contact
  email String?
  phone String?

  // Business
  nature_of_business String?

  // Feeder / grid
  dss_id       String?
  dss_name     String?
  feeder_id    String?
  feeder_name  String?
  feeder_band  String?
  status       Status?
  business_hub String?
  region       String?

  // Enumerator
  enumerator_name         String?
  enumerator_id           String?
  enumerator_phone_number String?
  remark                  String?

  // Audit
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  @@index([meter_number])
  @@index([customer_type])
  @@index([customer_category])
  @@index([service_center])
  @@index([state])
  @@index([lga])
  @@index([dss_id])
  @@index([feeder_id])
  @@index([enumerator_id])
  @@index([status])

  enumerations CustomerEnumeration[]
}

model User {
  id                   Int         @id @default(autoincrement())
  username             String      @unique
  name                 String
  email                String?     @unique
  phone                String?
  role                 UserRole
  hub                  Hub
  status               UserStatus  @default(ACTIVE)
  password_hash        String      @map("password_hash")
  must_change_password Boolean     @default(true) @map("must_change_password")
  last_login_at        DateTime?   @map("last_login_at")
  created_at           DateTime    @default(now()) @map("created_at")
  updated_at           DateTime    @updatedAt @map("updated_at")
  created_by           String?     @map("created_by")
  updated_by           String?     @map("updated_by")
  importJobs           ImportJob[]

  @@index([role])
  @@index([hub])
  @@index([status])
  @@map("users")

  enumerations CustomerEnumeration[]
}

model CustomerEnumeration {
  id             Int          @id @default(autoincrement())
  customer_id     Int
  account_number  String
  meter_number    String?
  user_id        Int?
  user_name      String
  service_center ServiceCenter?
  enumerated_at  DateTime     @default(now())
  before_data    Json?
  after_data     Json?

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([customer_id, enumerated_at])
  @@index([enumerated_at])
  @@index([service_center])
  @@index([user_id])
  @@map("customer_enumerations")
}

model ImportJob {
  id                Int             @id @default(autoincrement())
  file_name         String
  status            ImportJobStatus @default(VALIDATED)
  total_rows        Int             @default(0)
  valid_rows        Int             @default(0)
  invalid_rows      Int             @default(0)
  duplicate_rows    Int             @default(0)
  imported_rows     Int             @default(0)
  preview_rows      Json?
  validation_errors Json?
  duplicate_records Json?
  uploaded_at       DateTime        @default(now())
  completed_at      DateTime?
  updated_at        DateTime        @updatedAt
  uploaded_by_id    Int?
  uploaded_by       User?           @relation(fields: [uploaded_by_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([uploaded_at])
  @@index([uploaded_by_id])
  @@map("import_jobs")
}

model AuditEvent {
  id             Int      @id @default(autoincrement())
  actor_name     String
  actor_username String?
  actor_role     String?
  action         String
  entity_type    String
  entity_id      String?
  entity_label   String
  before_value   String?
  after_value    String?
  metadata       Json?
  occurred_at    DateTime @default(now())

  @@index([occurred_at])
  @@index([entity_type])
  @@index([actor_username])
  @@map("audit_events")
}
